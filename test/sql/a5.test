# a5_cell_to_subcell is the inverse of a5_cell_to_supercell
query I
select bool_and(a5_cell_to_supercell(c, 5) = a5_lonlat_to_cell(-122.4, 37.8, 5))
from (select unnest(a5_uncompact(a5_cell_to_subcell(a5_lonlat_to_cell(-122.4, 37.8, 5), 8))) as c)
