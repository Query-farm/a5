# a5_migrate: cell IDs created by a5 <= 0.10 map to the IDs of the same cells in the a5 1.0 index.
# These are the IDs a5 0.10 gave a5_lonlat_to_cell(44, 55, resolution) at resolutions 2 to 29.
query I
select bool_and(a5_migrate(id) = a5_lonlat_to_cell(44, 55, a5_get_resolution(id)))
from (select unnest([7241788200811757568, 7268809798575980544, 7271061598389665792, 7270498648436244480, 7270639385924599808, 7270604201552510976, 7270630589831577600, 7270689963459477504, 7270689413703663616, 7270689551142617088, 7270689516782878720, 7270689525372813312, 7270689514635395072, 7270689517319749632, 7270689517722402816, 7270689517554630656, 7270689517579796480, 7270689517586087936, 7270689517588709376, 7270689517589102592, 7270689517588938752, 7270689517588963328, 7270689517588985856, 7270689517588985344, 7270689517588987008, 7270689517588985376, 7270689517588985384, 7270689517588985382]::ubigint[]) as id)
----
true

# a5_migrate: IDs at resolution 0 are unchanged
query I
select a5_migrate(c) = c from (select unnest(a5_get_res0_cells()) as c) limit 1
