1	64	0

query III
select a5_area([a5_lonlat_to_cell(44, 55, 5)]) = a5_cell_area(5),
       a5_area(a5_compact(a5_cell_to_children(a5_lonlat_to_cell(44, 55, 5), 8))) = a5_cell_area(5),
       a5_area([]::ubigint[])
----
true	true	0.0

query II
select a5_count(NULL), a5_area(NULL)
----
NULL	NULL

# a5_contains: is a cell in a set of cells
query II
select a5_contains(a5_grid_disk(a5_lonlat_to_cell(-122.4, 37.8, 10), 1), a5_lonlat_to_cell(-122.4, 37.8, 10)),
       a5_contains(a5_grid_disk(a5_lonlat_to_cell(-122.4, 37.8, 10), 1), a5_lonlat_to_cell(44, 55, 10))
----
true	false

# a5_contains: the cell must be at the resolution of the set
