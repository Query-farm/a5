# a5_compact: a complete set of siblings is replaced by its parent. The result is a covering:
# the compacted cells followed by a compaction marker recording the resolution (here 2).
query I
select a5_compact(a5_cell_to_children(360287970189639680::ubigint))
----
[360287970189639680, 17294385519056126016]

# The compaction marker is not a cell
query III
select a5_is_compaction_marker(17294385519056126016::ubigint),
       a5_is_valid_cell(17294385519056126016::ubigint),
       a5_is_compaction_marker(360287970189639680::ubigint)
----
true	false	false

query I
select a5_is_compaction_marker(NULL)
----
NULL

# a5_uncompact without a target resolution expands a covering back to the resolution of its marker
query I
select a5_uncompact(a5_compact(a5_cell_to_children(360287970189639680::ubigint)))
     = a5_cell_to_children(360287970189639680::ubigint)
----
true

# ... or to the resolution of the finest cell when there is no marker
query I
select a5_uncompact([360287970189639680::ubigint])
----
[360287970189639680]

query II
select a5_compact([]::ubigint[]), a5_uncompact([]::ubigint[])
----
[]	[]

# a5_uncompact takes no target resolution: the set carries its own. To expand single cells to a
# given resolution use a5_cell_to_children.
statement error
select a5_uncompact([a5_lonlat_to_cell(-122.4, 37.8, 10)], 12)
----
No function matches

query I
select len(flatten(list_transform(a5_cell_to_children(360287970189639680::ubigint), c -> a5_cell_to_children(c, 3))))
----
16

