# a5_overlaps: do two sets of cells share any cell
query II
select a5_overlaps(a5_grid_disk(a5_lonlat_to_cell(-122.4, 37.8, 10), 1), a5_grid_disk_vertex(a5_lonlat_to_cell(-122.4, 37.8, 10), 2)),
       a5_overlaps(a5_grid_disk(a5_lonlat_to_cell(-122.4, 37.8, 10), 1), a5_grid_disk(a5_lonlat_to_cell(44, 55, 10), 1))
----
true	false

# a5_union / a5_intersect / a5_difference: the edge disk (6 cells) is a subset of the vertex disk (8 cells)
query III
select a5_count(a5_union(e, v)), a5_count(a5_intersect(e, v)), a5_count(a5_difference(v, e))
from (select a5_grid_disk(a5_lonlat_to_cell(-122.4, 37.8, 10), 1) as e,
             a5_grid_disk_vertex(a5_lonlat_to_cell(-122.4, 37.8, 10), 1) as v)
----
8	6	2

# The set operations return coverings: an empty result is just the compaction marker
query II
select a5_difference(e, e) = [e[-1]], a5_union(e, e) = e
from (select a5_grid_disk(a5_lonlat_to_cell(-122.4, 37.8, 10), 1) as e)
----
true	true

# The set operations work row by row
query I
select a5_count(a5_intersect(a5_grid_disk(a5_lonlat_to_cell(-122.4, 37.8, 10), k::integer), a5_grid_disk(a5_lonlat_to_cell(-122.4, 37.8, 10), 1)))
from range(3) t(k)
----
1
6
6

# The set operations need both sets at the same resolution
statement error
select a5_union(a5_grid_disk(a5_lonlat_to_cell(-122.4, 37.8, 10), 1), a5_grid_disk(a5_lonlat_to_cell(-122.4, 37.8, 9), 1))
----
a5_union: Cannot combine cells at resolution 10 with cells at resolution 9

query III
select a5_union(NULL, [a5_lonlat_to_cell(44, 55, 5)]), a5_overlaps([a5_lonlat_to_cell(44, 55, 5)], NULL), a5_contains(NULL, a5_lonlat_to_cell(44, 55, 5))
----
NULL	NULL	NULL

# a5_cell_to_supercell: the coarser cell containing the center of a cell
query II
select a5_cell_to_supercell(a5_lonlat_to_cell(-122.4, 37.8, 10), 5) = a5_lonlat_to_cell(-122.4, 37.8, 5),
       a5_cell_to_supercell(a5_lonlat_to_cell(-122.4, 37.8, 10), 10) = a5_lonlat_to_cell(-122.4, 37.8, 10)
