----
2	74

query II
select a5_count(a5_spherical_cap(a5_lonlat_to_cell(-122.4, 37.8, 10), 1000.0)), a5_count(a5_spherical_cap(a5_lonlat_to_cell(-122.4, 37.8, 10), 50000.0))
----
1	244

