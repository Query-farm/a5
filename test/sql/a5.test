# a5_cell_to_parent: without a resolution, the parent one resolution coarser
query II
select a5_cell_to_parent(a5_lonlat_to_cell(44, 55, 10)) = a5_cell_to_parent(a5_lonlat_to_cell(44, 55, 10), 9),
       a5_cell_to_parent(a5_get_res0_cells()[1]) = a5_world_cell()
